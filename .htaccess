# Cardify - Business Card Generator SaaS - Apache Configuration
# For cardify.om

# Enable Rewrite Engine
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Serve SVG favicon for default .ico requests
    RewriteRule ^favicon\.ico$ /favicon.svg [L]
    
    # Redirect old login URLs to unified login
    RewriteRule ^admin/login/?$ /login.php [R=301,L]
    RewriteRule ^company/login/?$ /login.php [R=301,L]
    RewriteRule ^printshop/login/?$ /login.php [R=301,L]
    
    # Force HTTPS in production (uncomment when SSL is configured)
    # RewriteCond %{HTTPS} off
    # RewriteCond %{HTTP_HOST} ^cardify\.om$ [NC]
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    
    # Redirect www to non-www (if needed)
    # RewriteCond %{HTTP_HOST} ^www\.cardify\.om$ [NC]
    # RewriteRule ^(.*)$ https://cardify.om/$1 [L,R=301]
    
    # VCF file routing: /{company_slug}/{email}.vcf -> vcf.php
    # Shorter URL for smaller QR codes
    # Example: cardify.om/acme/john@acme.com.vcf
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([a-z0-9-]+)/([^/]+)\.vcf$ vcf.php?company=$1&email=$2 [L,QSA]
    
    # Company admin routing: /{company_slug}/admin/{page} -> company_admin.php
    # Example: cardify.om/acme/admin/ or cardify.om/acme/admin/employees
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([a-z0-9-]+)/admin/?$ company_admin.php?company_slug=$1&page=index [L,QSA]
    
    # Handle .php extension in admin URLs (redirect to clean URL)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^([a-z0-9-]+)/admin/([a-z0-9_-]+)\.php$ /$1/admin/$2 [R=301,L]
    
    # Clean admin URLs
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([a-z0-9-]+)/admin/([a-z0-9_-]+)/?$ company_admin.php?company_slug=$1&page=$2 [L,QSA]
    
    # Department-specific portal routing: /{company_slug}/portal/{department_slug} -> portal.php
    # Example: cardify.om/acme/portal/sales
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([a-z0-9-]+)/portal/([a-z0-9-]+)/?$ portal.php?company_slug=$1&department_slug=$2 [L,QSA]

    # Employee portal routing: /{company_slug}/portal -> portal.php
    # Example: cardify.om/acme/portal
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([a-z0-9-]+)/portal/?$ portal.php?company_slug=$1 [L,QSA]
    
    # Share link routing (e.g., cardify.om/share/{token})
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^share/([a-zA-Z0-9]+)/?$ share/index.php?token=$1 [L,QSA]

    # Branded short-link shortener (cardify.om/s/<slug>)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^s/([A-Za-z0-9_-]{1,20})/?$ s.php?slug=$1 [L,QSA]

    # Referral link (cardify.om/r/<code>) — BHD-234
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^r/([A-Za-z0-9]{4,16})/?$ r.php?code=$1 [L,QSA]
    
    # Intro/onboarding page (clean URL)
    RewriteRule ^intro/?$ intro.php [L,QSA]

    # Blog clean URLs
    RewriteRule ^blog/?$ blog.php [L,QSA]
    RewriteRule ^blog/([a-z0-9-]+)/?$ blog.php?post=$1 [L,QSA]

    # Free tools cluster (client-side utilities, SEO assets)
    RewriteRule ^tools/?$ tools.php [L,QSA]
    RewriteRule ^tools/vcard-qr-generator/?$ tools/vcard-qr-generator.php [L,QSA]
    RewriteRule ^tools/email-signature-generator/?$ tools/email-signature-generator.php [L,QSA]
    RewriteRule ^tools/whatsapp-qr-generator/?$ tools/whatsapp-qr-generator.php [L,QSA]
    RewriteRule ^tools/nfc-business-card-guide/?$ tools/nfc-business-card-guide.php [L,QSA]

    # Internal design system showcase
    RewriteRule ^design-showcase/?$ design-showcase.php [L,QSA]
    RewriteRule ^design/?$ design-showcase.php [L,QSA]

    # Oman Business Index — directory of Omani enterprises (flagship + curated top companies)
    RewriteRule ^oman-business-index/?$ oman-business-index.php [L,QSA]
    RewriteRule ^gcc-business-index/?$  gcc-business-index.php [L,QSA]
    # No /ar/gcc-business-index rewrite yet — the page has no Arabic
    # localization. Route (and hreflang / sitemap entries) will be added
    # when translated content lands. Do NOT expose a locale route that
    # serves the English page — it creates a duplicate indexed as AR.
    RewriteRule ^companies/?$ companies.php [L,QSA]
    RewriteRule ^companies/sector/([a-z0-9-]+)/?$ companies.php?view=sector&slug=$1 [L,QSA]
    RewriteRule ^companies/wilayat/([a-z0-9-]+)/?$ companies.php?view=wilayat&slug=$1 [L,QSA]
    RewriteRule ^companies/([a-z0-9-]+)/?$ companies.php?view=company&slug=$1 [L,QSA]
    RewriteRule ^ar/companies/?$ companies.php?lang=ar [L,QSA]
    RewriteRule ^ar/companies/sector/([a-z0-9-]+)/?$ companies.php?view=sector&slug=$1&lang=ar [L,QSA]
    RewriteRule ^ar/companies/wilayat/([a-z0-9-]+)/?$ companies.php?view=wilayat&slug=$1&lang=ar [L,QSA]
    RewriteRule ^ar/companies/([a-z0-9-]+)/?$ companies.php?view=company&slug=$1&lang=ar [L,QSA]

    # Careers clean URLs
    RewriteRule ^careers/?$ careers.php [L,QSA]
    RewriteRule ^careers/([a-z0-9-]+)/?$ careers.php?job=$1 [L,QSA]

    # Industry landing pages
    RewriteRule ^industries/restaurants/?$ industries/restaurants.php [L,QSA]
    RewriteRule ^industries/construction/?$ industries/construction.php [L,QSA]
    RewriteRule ^industries/healthcare/?$ industries/healthcare.php [L,QSA]
    RewriteRule ^industries/real-estate/?$ industries/real-estate.php [L,QSA]
    RewriteRule ^industries/tourism/?$ industries/tourism.php [L,QSA]
    RewriteRule ^industries/banking/?$ industries/banking.php [L,QSA]
    RewriteRule ^industries/logistics/?$ industries/logistics.php [L,QSA]
    RewriteRule ^industries/oil-gas/?$ industries/oil-gas.php [L,QSA]
    RewriteRule ^industries/government/?$ industries/government.php [L,QSA]

    # Oman-specific solution pages (commercial intent SEO)
    RewriteRule ^solutions/?$ solutions.php [L,QSA]
    RewriteRule ^solutions/([a-z0-9-]+)/?$ solutions/$1.php [L,QSA]

    # Static page clean URLs
    RewriteRule ^faq/?$ faq.php [L,QSA]
    RewriteRule ^about/?$ about.php [L,QSA]
    RewriteRule ^contact/?$ contact.php [L,QSA]
    RewriteRule ^terms/?$ terms.php [L,QSA]
    RewriteRule ^privacy/?$ privacy.php [L,QSA]
    RewriteRule ^security/?$ security.php [L,QSA]
    RewriteRule ^cookies/?$ cookies.php [L,QSA]
    RewriteRule ^get-started/?$ get-started.php [L,QSA]
    RewriteRule ^claim/?$ claim.php [L,QSA]

    # Sitemap index + child sitemaps (split so Google can prioritise crawling)
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
    RewriteRule ^sitemap-static\.xml$       sitemap.php?part=static       [L,QSA]
    RewriteRule ^sitemap-tools\.xml$        sitemap.php?part=tools        [L,QSA]
    RewriteRule ^sitemap-solutions\.xml$    sitemap.php?part=solutions    [L,QSA]
    RewriteRule ^sitemap-directory\.xml$    sitemap.php?part=directory    [L,QSA]
    RewriteRule ^sitemap-companies\.xml$    sitemap.php?part=companies    [L,QSA]
    RewriteRule ^sitemap-companies-ar\.xml$ sitemap.php?part=companies-ar [L,QSA]
    RewriteRule ^sitemap-blog\.xml$         sitemap.php?part=blog         [L,QSA]

    # Print shop portal clean URLs
    # Example: cardify.om/printshop/dashboard
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^printshop/?$ printshop/dashboard.php [L,QSA]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^printshop/register/?$ printshop/register.php [L,QSA]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^printshop/dashboard/?$ printshop/dashboard.php [L,QSA]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^printshop/orders/?$ printshop/orders.php [L,QSA]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^printshop/order/([0-9]+)/?$ printshop/order.php?id=$1 [L,QSA]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^printshop/settings/?$ printshop/settings.php [L,QSA]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^printshop/profile/?$ printshop/profile.php [L,QSA]
    
    # Company-specific routing (e.g., cardify.om/acme/)
    # Check if request is not for known paths and not a file
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !^/(admin|login|logout|install|share|s/|company|companies|ar|oman-business-index|gcc-business-index|webhooks|amwalpay|api|assets|uploads|data|printshop|industries|solutions|intro|blog|careers|about|contact|faq|terms|privacy|security|cookies|sitemap\.xml|print-shops\.php|generate_card_html\.php|download_card\.php|index\.php|router\.php|vcf\.php|profile\.php|intro\.php|design-showcase|design|logos|logo-claim|logo-takedown|logo-download|sitemap-logos\.xml)
    RewriteRule ^([a-z0-9-]+)/?$ router.php?company_slug=$1 [L,QSA]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    # Prevent MIME type sniffing
    Header set X-Content-Type-Options "nosniff"
    
    # Prevent clickjacking
    Header set X-Frame-Options "SAMEORIGIN"
    
    # XSS Protection
    Header set X-XSS-Protection "1; mode=block"
    
    # Referrer Policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    
    # HSTS
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Prevent directory browsing
Options -Indexes

# Protect sensitive files
<FilesMatch "^(config\.php|\.htaccess|\.git|composer\.(json|lock))$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Protect sensitive directories
<IfModule mod_rewrite.c>
    RewriteRule ^data/print-sheets/ - [L]  # Allow print sheet downloads
    RewriteRule ^data/ - [F,L]
    RewriteRule ^logs/ - [F,L]
    RewriteRule ^api/check-slug\.php$ - [L]  # Allow API endpoint
    RewriteRule ^api/translate\.php$ - [L]  # Allow translation API
    RewriteRule ^api/get_templates_public\.php$ - [L]  # Allow public templates API
    RewriteRule ^api/check-employee\.php$ - [L]  # Allow employee check API
    RewriteRule ^api/file-manager.php$ - [L]  # Allow file-manager API
    RewriteRule ^api/linkedin/callback\.php$ - [L]  # Allow LinkedIn OAuth callback
    RewriteRule ^api/print-ready\.php$ - [L]  # Allow print-ready PDF generator API

    # --- Omani Logo Library --- (mirrors docs/logos-nginx-rewrites.conf)
    RewriteRule ^logos/?$                      logos.php?view=hub     [L,QSA]
    RewriteRule ^logos/press/?$                logos.php?view=press   [L,QSA]
    RewriteRule ^logos/terms/?$                logos.php?view=terms   [L,QSA]
    RewriteRule ^logos/([a-z0-9-]+)/?$         logos.php?view=sector&sector=$1 [L,QSA]
    # Arabic variants — logos.php reads ?lang=ar for RTL + AR copy.
    RewriteRule ^ar/logos/?$                   logos.php?view=hub&lang=ar   [L,QSA]
    RewriteRule ^ar/logos/press/?$             logos.php?view=press&lang=ar [L,QSA]
    RewriteRule ^ar/logos/terms/?$             logos.php?view=terms&lang=ar [L,QSA]
    RewriteRule ^ar/logos/([a-z0-9-]+)/?$      logos.php?view=sector&sector=$1&lang=ar [L,QSA]
    RewriteRule ^logo-claim/?$                 logo-claim.php         [L,QSA]
    RewriteRule ^logo-takedown/?$              logo-takedown.php      [L,QSA]
    RewriteRule ^logo-download/?$              logo-download.php      [L,QSA]
    RewriteRule ^api/logos/list/?$             api/logos/list.php     [L,QSA]
    RewriteRule ^api/logos/show/([a-z0-9-]+)/?$  api/logos/show.php?slug=$1 [L,QSA]
    RewriteRule ^api/logos/show/?$             api/logos/show.php     [L,QSA]
    RewriteRule ^api/logos/sectors/?$          api/logos/sectors.php  [L,QSA]
    RewriteRule ^api/logos/stats/?$            api/logos/stats.php    [L,QSA]
    RewriteRule ^sitemap-logos\.xml$           sitemap.php?part=logos [L,QSA]

    # Allow rewritten logo API .php targets (Apache re-runs rules after internal rewrite).
    RewriteRule ^api/logos/(list|show|sectors|stats)\.php$ - [L]

    # Admin-only: block direct access to pending uploads (served via PHP endpoint).
    RewriteRule ^storage/logos/pending/ - [F,L]

    RewriteRule ^api/ - [F,L]  # Block other API files
</IfModule>

# PHP Settings
<IfModule mod_php7.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 10M
    php_value max_execution_time 300
    php_value max_input_time 300
    php_value memory_limit 256M
</IfModule>

# Enable Gzip Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Custom Error Pages
ErrorDocument 404 /404.php
ErrorDocument 500 /500.php
ErrorDocument 503 /maintenance.php

# Prevent access to hidden files
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Block hidden directories (.git, .vscode, .idea, etc.)
# Block developer/asset directories not for public access
<IfModule mod_rewrite.c>
    RewriteRule ^\.git/ - [F,L]
    RewriteRule ^\.vscode/ - [F,L]
    RewriteRule ^\.idea/ - [F,L]
    RewriteRule ^\.cursor/ - [F,L]
    RewriteRule ^downloads/ - [F,L]
    RewriteRule ^database/ - [F,L]
    RewriteRule ^includes/ - [F,L]
</IfModule>
