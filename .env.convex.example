# Convex self-hosted secrets, copy to .env.convex on the VPS (gitignored).
#
# Generate INSTANCE_SECRET:
#   openssl rand -hex 32
# Generate CARDIFY_INGEST_SECRET (used by PHP -> Convex):
#   openssl rand -hex 32
# Generate CONVEX_AUTH_SECRET (used by PHP to mint admin JWTs):
#   openssl rand -hex 32

INSTANCE_SECRET=replace-me-with-openssl-rand-hex-32
CARDIFY_INGEST_SECRET=replace-me-with-openssl-rand-hex-32
CONVEX_AUTH_SECRET=replace-me-with-openssl-rand-hex-32

# Public-facing URLs (nginx proxies to 127.0.0.1:3210 / :3211).
CONVEX_CLOUD_ORIGIN=https://cardify.om/_convex/api
CONVEX_SITE_ORIGIN=https://cardify.om/_convex/http
