# OS / Editor files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# Logs
*.log
logs/
error_log
access_log

# Composer / Dependencies
vendor/
composer.phar
# composer.lock IS committed (application, not library) for reproducible deploys

# lean-ctx local cache (developer tooling, never commit)
.lean-ctx/

# Configuration (contains secrets)
config.php

# Runtime/user data (multi-tenant SaaS will store these per company)
data/*.json
data/companies/
data/print-sheets/
data/proofs/
data/cards/
# Wallet signing material (Apple PEM/.p12, Google service-account JSON).
# Lives ONLY on the server; never commit. nginx denies /data/wallet/ too.
data/wallet/
uploads/
!uploads/.gitkeep

# Environment files
.env
.env.local
.env.*.local

# Cache
cache/
tmp/
*.cache

# Backup files
*.bak
*.backup
*.sql.gz
*.sql.bak

# Bulk-claim CSV seeds (contain customer PII — local only)
docs/bulk-claim-seed*.csv

# IDE specific
.phpunit.result.cache
.php-cs-fixer.cache

# OS generated
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Cursor local state (DO NOT COMMIT)
.cursor/
downloads/
node_modules/
php_errorlog
*.sql.gz
malware.*
.user.ini
.ftpquota
data/oman-enterprises*.xlsx
data/oman-enterprises-enriched.csv

# Playwright E2E artifacts
playwright-report/
test-results/
blob-report/
playwright/.cache/
.gstack/

# Convex self-hosted (live analytics)
.env.convex
convex-data/
convex/_generated/
convex/convex/_generated/
analytics-ui/dist/
analytics-ui/node_modules/
convex/node_modules/

# Local Conductor / Cursor worktrees (host-only)
.worktrees/

# Logo library runtime storage (files tracked via .gitkeep only)
/storage/logos/indexed/*
/storage/logos/verified/*
/storage/logos/pending/*
/storage/og/logos/*
!/storage/logos/indexed/.gitkeep
!/storage/logos/verified/.gitkeep
!/storage/logos/pending/.gitkeep
!/storage/og/logos/.gitkeep

# runtime-generated OG images
storage/og/

# Local pitch-video masters (33MB, referenced by nothing on the site).
# They live on the box only so the deploy clean-tree assert stays green.
promo/cardify-yc-demo*.mp4

# Python bytecode. Nine .pyc files were TRACKED, so any pytest run rewrote them
# and dirtied the tree, which matters here because the deploy asserts a clean
# tree. They are build output of scripts/*.py and tests/python/*.py and nothing
# reads them from the repo.
__pycache__/
*.py[cod]
