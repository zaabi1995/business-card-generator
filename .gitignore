*~

# Logs
*.log
logs/
error_log
access_log

# Composer / Dependencies
vendor/
composer.lock
composer.phar

# Configuration (contains secrets)
config.php

# Runtime/user data (multi-tenant SaaS will store these per company)
data/*.json
data/companies/
data/print-sheets/
data/proofs/
data/cards/
uploads/
!uploads/.gitkeep

# Environment files
.env
.env.local
.env.*.local

# Cache
cache/
tmp/
*.cache

# Backup files
*.bak
*.backup
*.sql.gz
*.sql.bak

# Bulk-claim CSV seeds (contain customer PII — local only)
docs/bulk-claim-seed*.csv

# IDE specific
.phpunit.result.cache
.php-cs-fixer.cache

# OS generated
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Cursor local state (DO NOT COMMIT)
.cursor/
downloads/
node_modules/
php_errorlog
*.sql.gz
malware.*
.user.ini
.ftpquota
data/oman-enterprises*.xlsx
data/oman-enterprises-enriched.csv

# Playwright E2E artifacts
playwright-report/
test-results/
blob-report/
playwright/.cache/

# Logo library runtime storage (files tracked via .gitkeep only)
/storage/logos/indexed/*
/storage/logos/verified/*
/storage/logos/pending/*
/storage/og/logos/*
!/storage/logos/indexed/.gitkeep
!/storage/logos/verified/.gitkeep
!/storage/logos/pending/.gitkeep
!/storage/og/logos/.gitkeep
